<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>Sonar.Fishing.Ipc.IntegrationTests</AssemblyName>
    <RootNamespace>Sonar.Fishing.Ipc.IntegrationTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\dotnet\Sonar.Fishing.Host\Sonar.Fishing.Host.csproj" />
    <ProjectReference Include="..\..\..\src\dotnet\Sonar.Fishing.Ipc.Contracts\Sonar.Fishing.Ipc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\fixtures\ipc\v1\catch_quality_request.hex"
          Link="fixtures\ipc\v1\catch_quality_request.hex"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\ipc\v1\catch_disposition_request.hex"
          Link="fixtures\ipc\v1\catch_disposition_request.hex"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\licensing\signed-entitlement-v1.properties"
          Link="fixtures\licensing\signed-entitlement-v1.properties"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\licensing\signed-entitlement-v1-body.hex"
          Link="fixtures\licensing\signed-entitlement-v1-body.hex"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\licensing\signed-entitlement-v1-public.pem"
          Link="fixtures\licensing\signed-entitlement-v1-public.pem"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
