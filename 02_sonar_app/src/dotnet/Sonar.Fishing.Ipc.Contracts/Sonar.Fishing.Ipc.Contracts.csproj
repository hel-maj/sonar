<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Sonar.Fishing.Ipc.Contracts</AssemblyName>
    <RootNamespace>Sonar.Fishing.Ipc.Contracts</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <ProductRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</ProductRoot>
    <GeneratedContractRoot>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)GeneratedContracts'))</GeneratedContractRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sonar.Inventory.Ipc.Contracts" Version="[0.1.0]" />
    <PackageReference Include="Sonar.Platform.Ipc.Contracts" Version="[0.1.1]" />
    <Compile Include="$(GeneratedContractRoot)\SonarFishing.cs" />
    <Compile Include="$(GeneratedContractRoot)\FishingSchemaIdentity.g.cs" />
  </ItemGroup>

  <Target Name="GenerateFishingManagedContracts" BeforeTargets="BeforeCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProductRoot)\scripts\generate_ipc_contracts.ps1&quot; -CommonContractRoot &quot;$(SonarPlatformIpcContractRoot)&quot; -InventoryContractRoot &quot;$(SonarInventoryIpcContractRoot)&quot; -OutputDirectory &quot;$(GeneratedContractRoot)&quot; -ProtocExecutable &quot;$(SonarProtocExecutable)&quot;" />
  </Target>
</Project>
