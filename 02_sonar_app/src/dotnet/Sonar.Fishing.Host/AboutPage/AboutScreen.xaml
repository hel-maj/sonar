<UserControl
    x:Class="Sonar.Fishing.Host.AboutPage.AboutScreen"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Sonar.UI.Wpf.Controls;assembly=Sonar.UI.Wpf"
    xmlns:layout="clr-namespace:Sonar.UI.Wpf.Layout;assembly=Sonar.UI.Wpf"
    AutomationProperties.Name="О программе"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <common:PageScrollViewer>
        <common:PageContainer>
            <StackPanel>
                <common:PageHeader
                    x:Name="AboutHeader"
                    Title="О программе"
                    Subtitle="Sonar Fishing" />

                <layout:ResponsiveGrid Margin="0,24,0,0">
                    <common:MetricCard
                        layout:ResponsiveGrid.CompactSpan="4"
                        layout:ResponsiveGrid.MediumSpan="4"
                        layout:ResponsiveGrid.ExpandedSpan="4"
                        Label="Версия"
                        Value="{Binding ViewModel.Version, ElementName=Root}" />
                    <common:MetricCard
                        layout:ResponsiveGrid.CompactSpan="4"
                        layout:ResponsiveGrid.MediumSpan="4"
                        layout:ResponsiveGrid.ExpandedSpan="4"
                        Label="Сборка"
                        Value="{Binding ViewModel.Build, ElementName=Root}" />
                    <common:MetricCard
                        layout:ResponsiveGrid.CompactSpan="4"
                        layout:ResponsiveGrid.MediumSpan="8"
                        layout:ResponsiveGrid.ExpandedSpan="4"
                        Label="Подписка"
                        Value="{Binding ViewModel.Subscription, ElementName=Root}" />
                </layout:ResponsiveGrid>

                <common:Card Margin="0,24,0,0" Header="Диагностика">
                    <StackPanel>
                        <TextBlock
                            Text="{Binding ViewModel.DiagnosticsStatus, ElementName=Root}"
                            TextWrapping="Wrap" />
                        <common:ActionButton
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Очистить журнал"
                            Command="{Binding ViewModel.ClearDiagnosticsCommand, ElementName=Root}"
                            Content="Очистить журнал"
                            IsEnabled="{Binding ViewModel.CanClearDiagnostics, ElementName=Root}"
                            Role="Default" />
                    </StackPanel>
                </common:Card>
            </StackPanel>
        </common:PageContainer>
    </common:PageScrollViewer>
</UserControl>
