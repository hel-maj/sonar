<UserControl
    x:Class="Sonar.Fishing.Host.InventoryPage.InventoryScreen"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Sonar.UI.Wpf.Controls;assembly=Sonar.UI.Wpf"
    AutomationProperties.Name="Инвентарь"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <DataTemplate x:Key="InventoryDetailsTemplate">
            <StackPanel MinWidth="360">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Foreground="{DynamicResource Sonar.Brush.TextMuted}"
                            Text="{Binding Category}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <common:InventoryImageSlot
                        Grid.Column="1"
                        Width="104"
                        Height="72"
                        Padding="2"
                        HorizontalAlignment="Right"
                        AutomationLabel="{Binding Name, StringFormat=Изображение {0}}"
                        Source="{Binding IconSource}"
                        State="{Binding IconState}" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{DynamicResource Sonar.Brush.TextMuted}" Text="Каталог" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding CatalogText}" />
                    <TextBlock Grid.Row="1" Margin="0,4,0,0" Foreground="{DynamicResource Sonar.Brush.TextMuted}" Text="Ячейка" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding CellText}" />
                    <TextBlock Grid.Row="2" Margin="0,4,0,0" Foreground="{DynamicResource Sonar.Brush.TextMuted}" Text="Размер" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding FootprintText}" />
                    <TextBlock Grid.Row="3" Margin="0,4,0,0" Foreground="{DynamicResource Sonar.Brush.TextMuted}" Text="Количество" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding CountText}" />
                    <TextBlock Grid.Row="4" Margin="0,4,0,0" Foreground="{DynamicResource Sonar.Brush.TextMuted}" Text="Вес" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding WeightText}" />
                    <TextBlock Grid.Row="5" Margin="0,4,0,0" Foreground="{DynamicResource Sonar.Brush.TextMuted}" Text="Состояние" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding ConditionText}" />
                </Grid>

                <TextBlock
                    Margin="0,14,0,0"
                    Text="{Binding DescriptionText}"
                    TextWrapping="Wrap" />
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding DetailLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,4" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <common:PageScrollViewer>
        <common:PageContainer>
            <StackPanel>
                <common:PageHeader Title="Инвентарь">
                    <common:PageHeader.Status>
                        <common:StatusBadge
                            Content="{Binding ViewModel.StatusText, ElementName=Root}"
                            Tone="{Binding ViewModel.StatusTone, ElementName=Root}" />
                    </common:PageHeader.Status>
                </common:PageHeader>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <common:MetricCard
                        Label="Вес"
                        Value="{Binding ViewModel.WeightText, ElementName=Root}" />
                    <common:MetricCard
                        Grid.Column="2"
                        Label="Позиции"
                        Value="{Binding ViewModel.ItemCountText, ElementName=Root}" />
                </Grid>

                <common:CommandBar>
                    <common:CommandBar.Actions>
                        <common:NonScrollingComboBox
                            Width="180"
                            Margin="0,0,8,0"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding ViewModel.CategoryOptions, ElementName=Root}"
                            SelectedItem="{Binding ViewModel.SelectedCategoryOption, ElementName=Root, Mode=TwoWay}"
                            ToolTip="Фильтр по категории" />
                    </common:CommandBar.Actions>
                    <common:SearchBox
                        Width="260"
                        ClearAutomationLabel="Очистить поиск"
                        Placeholder="Поиск по названию..."
                        Text="{Binding ViewModel.Search, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </common:CommandBar>

                <common:PageStatePresenter
                    State="{Binding ViewModel.ContentState, ElementName=Root}"
                    StateMessage="{Binding ViewModel.StateMessage, ElementName=Root}"
                    StateTitle="{Binding ViewModel.StateTitle, ElementName=Root}">
                    <TabControl
                        SelectedIndex="{Binding ViewModel.ViewModeIndex, ElementName=Root, Mode=TwoWay}"
                        Style="{DynamicResource Sonar.TabControl}">
                        <TabItem Header="Таблица">
                            <DataGrid
                                x:Name="InventoryTable"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding ViewModel.VisibleItems, ElementName=Root}"
                                Style="{DynamicResource Sonar.Inventory.DataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="56" CanUserSort="False" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <common:InfoPopoverTrigger
                                                    AutomationLabel="{Binding Name, StringFormat=Информация о предмете {0}}"
                                                    HoverCloseDelay="240"
                                                    HoverOpenDelay="500"
                                                    OpenOnKeyboardFocus="False"
                                                    PinOnClick="False"
                                                    PopoverContent="{Binding}"
                                                    PopoverContentTemplate="{StaticResource InventoryDetailsTemplate}"
                                                    PopoverMaxHeight="440"
                                                    PopoverMaxWidth="460"
                                                    PopupPlacement="Right" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn
                                        Width="*"
                                        CellStyle="{StaticResource Sonar.Inventory.DataGrid.ItemCell}"
                                        Header="Предмет">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <common:InventoryItemCell
                                                    ImageState="{Binding IconState}"
                                                    Source="{Binding IconSource}"
                                                    Title="{Binding Name}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="0.8*" Binding="{Binding CountText}" Header="Кол-во" />
                                    <DataGridTextColumn Width="0.9*" Binding="{Binding WeightText}" Header="Вес" />
                                    <DataGridTextColumn Width="1.1*" Binding="{Binding ConditionText}" Header="Состояние" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Сетка">
                            <ScrollViewer
                                x:Name="SpatialScroll"
                                MaxHeight="680"
                                HorizontalContentAlignment="Stretch"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding ViewModel.VisibleItems, ElementName=Root}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="common:InventorySpatialPanel.Column" Value="{Binding Column}" />
                                            <Setter Property="common:InventorySpatialPanel.ColumnSpan" Value="{Binding ColumnSpan}" />
                                            <Setter Property="common:InventorySpatialPanel.Row" Value="{Binding Row}" />
                                            <Setter Property="common:InventorySpatialPanel.RowSpan" Value="{Binding RowSpan}" />
                                            <Setter Property="VerticalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <common:InventorySpatialPanel
                                                CellBackground="{DynamicResource Sonar.Brush.SurfaceSoft}"
                                                CellBorderBrush="{DynamicResource Sonar.Brush.Border}"
                                                Columns="{Binding ViewModel.GridColumns, Source={x:Reference Root}}"
                                                FallbackCellSize="{DynamicResource Sonar.Control.TouchTarget}"
                                                Gap="{DynamicResource Sonar.Space.2}"
                                                OuterPadding="8"
                                                Rows="{Binding ViewModel.GridRows, Source={x:Reference Root}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <common:Card
                                                Margin="0"
                                                Padding="4"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <common:InventoryImageSlot
                                                        AutomationLabel="{Binding Name, StringFormat=Изображение {0}}"
                                                        ColumnSpan="{Binding ColumnSpan}"
                                                        RowSpan="{Binding RowSpan}"
                                                        Source="{Binding IconSource}"
                                                        State="{Binding IconState}" />
                                                    <Border
                                                        Margin="4"
                                                        Padding="5,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource Sonar.Brush.Accent}"
                                                        CornerRadius="{DynamicResource Sonar.Corner.Small}">
                                                        <TextBlock
                                                            Foreground="{DynamicResource Sonar.Brush.OnAccent}"
                                                            Text="{Binding CountOverlayText}" />
                                                    </Border>
                                                    <common:InfoPopoverTrigger
                                                        Margin="4"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        AutomationLabel="{Binding Name, StringFormat=Информация о предмете {0}}"
                                                        HoverCloseDelay="240"
                                                        HoverOpenDelay="500"
                                                        OpenOnKeyboardFocus="False"
                                                        PinOnClick="False"
                                                        PopoverContent="{Binding}"
                                                        PopoverContentTemplate="{StaticResource InventoryDetailsTemplate}"
                                                        PopoverMaxHeight="440"
                                                        PopoverMaxWidth="460"
                                                        PopupPlacement="Left" />
                                                </Grid>
                                            </common:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </common:PageStatePresenter>
            </StackPanel>
        </common:PageContainer>
    </common:PageScrollViewer>
</UserControl>
