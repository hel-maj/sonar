<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Sonar.Fishing.Host</AssemblyName>
    <RootNamespace>Sonar.Fishing.Host</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <SonarFishingDeveloperFullAccess Condition="'$(SonarFishingDeveloperFullAccess)' == ''">false</SonarFishingDeveloperFullAccess>
    <DefineConstants Condition="'$(SonarFishingDeveloperFullAccess)' == 'true'">$(DefineConstants);SONAR_FISHING_DEVELOPER_FULL_ACCESS</DefineConstants>
    <SonarFishingStreamingToolRoot Condition="'$(SonarFishingStreamingToolRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\config\streaming\bin</SonarFishingStreamingToolRoot>
    <SonarFishingEmbeddedStreaming Condition="'$(SonarFishingEmbeddedStreaming)' == '' and '$(SonarFishingDeveloperFullAccess)' == 'true' and Exists('$(SonarFishingStreamingToolRoot)\ffmpeg.exe') and Exists('$(SonarFishingStreamingToolRoot)\cloudflared.exe')">true</SonarFishingEmbeddedStreaming>
    <SonarFishingEmbeddedStreaming Condition="'$(SonarFishingEmbeddedStreaming)' == ''">false</SonarFishingEmbeddedStreaming>
    <DefineConstants Condition="'$(SonarFishingEmbeddedStreaming)' == 'true'">$(DefineConstants);SONAR_FISHING_EMBEDDED_STREAMING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SonarFishingReleaseBundle)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>
    <ErrorOnDuplicatePublishOutputFiles>true</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.4.2]" />
    <PackageReference Include="Sonar.Licensing.Verification" Version="[0.1.3]" />
    <PackageReference Include="Sonar.Platform.Ipc.Contracts" Version="[0.1.1]" />
    <PackageReference Include="Sonar.Platform.Ipc.NamedPipes" Version="[0.1.1]" />
    <PackageReference Include="Sonar.Platform.Processes" Version="[0.1.0]" />
    <PackageReference Include="Sonar.UI.Wpf" Version="[0.2.22]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sonar.Fishing.Ipc.Contracts\Sonar.Fishing.Ipc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\sonar_logo.png" LogicalName="Assets/sonar_logo.png" />
    <Resource Include="Assets\Fish\*.png" />
    <EmbeddedResource
        Include="..\..\..\contracts\fishing\fish-catalog.json"
        LogicalName="Sonar.Fishing.Host.ProductCatalog.fish-catalog.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(SonarFishingEmbeddedStreaming)' == 'true'">
    <EmbeddedResource
        Include="$(MSBuildProjectDirectory)\..\..\..\contracts\streaming-tool-manifest.json"
        LogicalName="Sonar.Fishing.Host.Streaming.tool-manifest.json" />
    <EmbeddedResource
        Include="$(SonarFishingStreamingToolRoot)\ffmpeg.exe"
        LogicalName="Sonar.Fishing.Host.Streaming.ffmpeg.exe" />
    <EmbeddedResource
        Include="$(SonarFishingStreamingToolRoot)\cloudflared.exe"
        LogicalName="Sonar.Fishing.Host.Streaming.cloudflared.exe" />
  </ItemGroup>
</Project>
