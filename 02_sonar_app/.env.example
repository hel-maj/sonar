# Copy this file to .env and adjust values for local release work.
# .env is ignored by git.

SONAR_LICENSE_SERVER_URL=https://m-sonar-addr.ru

# Optional. Leave empty unless you intentionally use account-scoped Keygen routes.
# SONAR_LICENSE_ACCOUNT_ID=

# Required for launch-capable release builds. The check URL must be independent from /download.
# SONAR_STARTUP_BLOCK_URL=https://m-sonar-addr.ru/api/startup-block
# SONAR_STARTUP_BLOCK_PUBLIC_KEY=<ed25519-public-key-hex-or-base64url>

# Optional debug override. Normally release metadata is read from
# https://m-sonar-addr.ru/sonar-release.json
# SONAR_RELEASE_METADATA_URL=

